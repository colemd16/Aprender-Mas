# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eval run outputs
/evals/results/

# verb data: only the CSV the seed reads (plus its license and readme) is kept
/data/fred-jehle-spanish-verbs/*
!/data/fred-jehle-spanish-verbs/jehle_verb_database.csv
!/data/fred-jehle-spanish-verbs/license.txt
!/data/fred-jehle-spanish-verbs/README.md
